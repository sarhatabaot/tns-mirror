# tns-mirror-server — copy to .env and fill in. Never commit the result.
#
# Every value here is a PLACEHOLDER. The image ships with no TNS identity: the
# tns_marker and bot api_key identify a specific TNS account, so each deployer
# registers their own at https://www.wis-tns.org/ (Sign up, then Bot Management
# under your profile for the bot path).

# --- database (write credentials; the server is the sole writer) -------------
POSTGRES_DB=tnsdb
POSTGRES_USER=tns_writer
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-24

# When running the server outside compose, set the standard libpq variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=tns_writer
# PGPASSWORD=your-password
# PGDATABASE=tnsdb
#
# DATABASE_URL works too, but a URL has to be escaped: 'openssl rand -base64 24'
# produces a '/' about 39% of the time and a '/' ends the authority section, so
# the password becomes part of the host. The variables above cannot break.
# DATABASE_URL=postgresql://tns_writer:PASSWORD@localhost:5432/tnsdb

# --- TNS credential: pick ONE mode ------------------------------------------

# Mode 1 — "marker": a registered account's tns_marker User-Agent.
TNS_AUTH_MODE=marker
TNS_USER_AGENT=tns_marker{"tns_id":"0000","type":"user","name":"YOUR_TNS_USERNAME"}

# Mode 2 — "bot": a TNS bot's api_key, submitted as form data.
# TNS_AUTH_MODE=bot
# TNS_API_KEY=0000000000000000000000000000000000000000
# TNS_BOT_ID=0000
# TNS_BOT_NAME=YOUR_BOT_NAME

# --- download ----------------------------------------------------------------
# Seconds between consecutive downloads during catch-up. Do not lower this
# without a reason: TNS rate-limits, and a 429 stops catch-up early.
TNS_THROTTLE=10
# TNS_TIMEOUT=120
# TNS_WORKDIR=/var/lib/tns-mirror

# --- schedule (used by `serve` only; Kubernetes uses CronJobs) ---------------
# TNS_FULL_CRON=0 0 * * *          # daily full snapshot
# TNS_DELTA_CRON=10 * * * *        # hourly delta
# TNS_CATCHUP_CRON=30 0 * * *      # daily 24h catch-up, repairs missed hours
# TNS_CATCHUP_HOURS=1              # window for the hourly job
# TNS_CATCHUP_WINDOW_HOURS=24      # window for the daily catch-up job

# --- schema placement --------------------------------------------------------
# TNS_SCHEMA=public
# TNS_TABLE=tns_objects
