<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and page.url != "/" %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{% if summary %}{{ summary }}{% else %}{{ site.description }}{% endif %}" />
    <meta name="color-scheme" content="light dark" />

    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}" />
    <link rel="stylesheet" href="{{ '/pagefind/pagefind-ui.css' | url }}" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2213%22 font-size=%2213%22>🔭</text></svg>"
    />

    {% comment %}
      Applied before first paint. Any later and the page flashes the wrong theme
      on every navigation, which is worse than having no toggle at all.
    {% endcomment %}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {
          /* private mode, or storage disabled — the media query still applies */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#content">Skip to content</a>

    <header class="masthead">
      <div class="wrapper repel">
        <a class="brand cluster" href="{{ '/' | url }}">
          <span aria-hidden="true">🔭</span>
          <span>{{ site.title }}</span>
          <span class="brand__version">v{{ site.version }}</span>
        </a>

        <div class="cluster" style="--gutter: var(--space-xs)">
          {% include "partials/search.liquid" %}

          <button
            class="icon-button"
            type="button"
            id="theme-toggle"
            aria-label="Switch between light and dark theme"
            title="Switch theme"
          >
            <svg class="icon icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2v2.6M12 19.4V22M4.2 12H2M22 12h-2.2M5.6 5.6 4 4M20 20l-1.6-1.6M18.4 5.6 20 4M4 20l1.6-1.6" />
            </svg>
            <svg class="icon icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" />
            </svg>
          </button>

          <a
            class="icon-button"
            href="{{ site.repository }}"
            rel="noopener"
            aria-label="Source on GitHub"
            title="Source on GitHub"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="icon icon--filled">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <div class="wrapper page">
      {% include "partials/nav.liquid" %}

      <main id="content" class="flow prose" data-pagefind-body>
        {% if title and page.url != "/" %}
          <h1>{{ title }}</h1>
          {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
        {% endif %}
        {{ content }}
      </main>

      {% include "partials/toc.liquid" %}
    </div>

    {% include "partials/footer.liquid" %}

    <script>
      (function () {
        var toggle = document.getElementById("theme-toggle");
        if (!toggle) return;

        toggle.addEventListener("click", function () {
          var root = document.documentElement;
          var current = root.getAttribute("data-theme");
          if (!current) {
            // No explicit choice yet: flip away from whatever the OS is doing.
            var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            current = prefersDark ? "dark" : "light";
          }
          var next = current === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {
            /* nothing to do; the choice just will not persist */
          }
        });
      })();
    </script>

    <script src="{{ '/pagefind/pagefind-ui.js' | url }}" onerror="this.dataset.failed=1"></script>
    <script>
      window.addEventListener("DOMContentLoaded", function () {
        // Absent during a bare `eleventy --serve` before the index is built.
        if (typeof PagefindUI === "undefined") return;
        new PagefindUI({
          element: "#search",
          bundlePath: "{{ '/pagefind/' | url }}",
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: { placeholder: "Search docs" },
        });
      });
    </script>
  </body>
</html>
