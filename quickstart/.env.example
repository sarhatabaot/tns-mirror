# OPTIONAL. The compose file works on its own — every value in it takes a
# ${VAR:-default}, so this file exists only if you would rather keep credentials
# out of docker-compose.yml than edit it in place.
#
#   cp .env.example .env
#
# Anything set here wins over the compose file's defaults. Two values actually
# matter: a database password, and a TNS credential. Never commit the result.

# ---------------------------------------------------------------------------
# 1. Database password  (REQUIRED)
# ---------------------------------------------------------------------------
# Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME

# Optional — the defaults are fine.
# POSTGRES_DB=tnsdb
# POSTGRES_USER=tns_writer

# ---------------------------------------------------------------------------
# 2. TNS credential  (REQUIRED — pick ONE mode)
# ---------------------------------------------------------------------------
# TNS access is per-account and the mirror never downloads anonymously: with
# neither mode configured the server refuses to start syncing.
#
# Register at https://www.wis-tns.org/ — then either copy your account's
# tns_marker (mode 1), or create a bot under your profile's Bot Management and
# use its api_key (mode 2).
#
# Everything below is a PLACEHOLDER. The image ships with no TNS identity,
# because a tns_marker and an api_key identify a *specific account*.

# --- Mode 1: marker (simplest) ---
TNS_AUTH_MODE=marker
TNS_USER_AGENT=tns_marker{"tns_id":"0000","type":"user","name":"YOUR_TNS_USERNAME"}

# --- Mode 2: bot ---
# TNS_AUTH_MODE=bot
# TNS_API_KEY=0000000000000000000000000000000000000000
# TNS_BOT_ID=0000
# TNS_BOT_NAME=YOUR_BOT_NAME

# ---------------------------------------------------------------------------
# 3. Optional
# ---------------------------------------------------------------------------
# Pin the image instead of tracking :latest. Recommended for anything you rely on.
# TNS_MIRROR_VERSION=1.0.2

# Seconds between downloads during catch-up. Do not lower without a reason:
# TNS rate-limits, and a 429 stops the catch-up early.
# TNS_THROTTLE=10

# Schedules, in UTC (TNS stages its hourly files on UT hours).
# TNS_FULL_CRON=0 0 * * *       # daily full snapshot
# TNS_DELTA_CRON=10 * * * *     # hourly delta
# TNS_CATCHUP_CRON=30 0 * * *   # daily 24h catch-up, repairs missed hours
