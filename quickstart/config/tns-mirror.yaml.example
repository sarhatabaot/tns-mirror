# Optional YAML configuration.
#
# You do not need this file — everything here can be set with environment
# variables in .env, and the defaults below are what the server uses anyway.
# It is worth having when you want your configuration in version control with
# comments explaining your choices, rather than spread across a .env.
#
# To use it:
#   1. cp config/tns-mirror.yaml.example config/tns-mirror.yaml
#   2. in docker-compose.yml, uncomment the config volume mount and
#      TNS_MIRROR_CONFIG
#   3. docker compose up -d
#
# ${VAR} and ${VAR:-default} expand from the environment, so secrets stay in
# .env and this file is safe to commit.
#
# Precedence:  defaults  <  this file  <  environment

auth:
  # "marker" — your TNS account's tns_marker User-Agent, sent on a GET.
  # "bot"    — a TNS bot's api_key, submitted as form data on a POST.
  # With neither configured the server refuses to download. There is no
  # anonymous fallback.
  mode: ${TNS_AUTH_MODE:-marker}
  user_agent: ${TNS_USER_AGENT}
  # api_key: ${TNS_API_KEY}
  # bot_id: ${TNS_BOT_ID}
  # bot_name: ${TNS_BOT_NAME}

download:
  url: https://www.wis-tns.org/system/files/tns_public_objects/tns_public_objects.csv.zip
  timeout_seconds: 120
  # Seconds between consecutive downloads during a catch-up. TNS rate-limits;
  # a 429 stops the catch-up early rather than hammering it.
  throttle_seconds: 10
  # Transient zip/csv working area. Safe to wipe — costs one re-download.
  workdir: /var/lib/tns-mirror

database:
  # Write credentials for the mirror's own database. Consumers never get these;
  # they get a separate read-only role. Generate it with:
  #   docker compose exec server tns-mirror-server print-grants --database tnsdb
  dsn: ${DATABASE_URL}
  schema: public
  table: tns_objects

# All times UTC, because TNS stages its hourly files on UT hours and a
# local-time schedule would drift off them twice a year.
# An empty string disables a job.
schedule:
  full_cron: "0 0 * * *"      # daily full snapshot
  delta_cron: "10 * * * *"    # hourly delta
  catchup_cron: "30 0 * * *"  # daily 24h catch-up; repairs hours missed downtime
  catchup_hours: 1            # window applied by the hourly job
  catchup_window_hours: 24    # window applied by the daily catch-up job
